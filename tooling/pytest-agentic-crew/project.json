{
  "name": "pytest-agentic-crew",
  "tags": ["lang:py", "scope:crew", "scope:testing"],
  "targets": {
    "test": {
      "command": "uv run --project {projectRoot} python -m pytest {projectRoot}/tests -v --tb=short",
      "inputs": ["{projectRoot}/src/**/*.py", "{projectRoot}/tests/**/*.py", "{projectRoot}/pyproject.toml"]
    },
    "lint": {
      "command": "uv run --project {projectRoot} --with ruff python -m ruff check {projectRoot}",
      "inputs": ["{projectRoot}/src/**/*.py"]
    },
    "typecheck": {
      "command": "uv run --project {projectRoot} --with mypy python -m mypy {projectRoot}/src/pytest_agentic_crew",
      "inputs": ["{projectRoot}/src/**/*.py"]
    }
  }
}
