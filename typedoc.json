{
  "$schema": "https://typedoc.org/schema.json",
  "name": "agentic",
  "entryPoints": [
    "./packages/agentic/src/index.ts",
    "./tooling/vitest-agentic/src/index.ts"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "./packages/agentic/tsconfig.json",
  "out": "./docs/_build/api",
  "theme": "default",
  "readme": "./README.md",
  "excludeNotDocumented": false,
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "excludeReferences": false,
  "skipErrorChecking": false,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "sort": ["source-order"],
  "groupOrder": ["Classes", "Interfaces", "Type Aliases", "Functions", "Variables"],
  "categoryOrder": ["Core", "Fleet", "Triage", "GitHub", "Handoff", "Sandbox", "Crews", "*"],
  "navigationLinks": {
    "GitHub": "https://github.com/jbcom/agentic",
    "npm": "https://www.npmjs.com/package/@jbcom/agentic"
  },
  "customCss": "./docs/_static/typedoc.css",
  "includeVersion": true,
  "sourceLinkTemplate": "https://github.com/jbcom/agentic/blob/{gitRevision}/{path}#L{line}"
}
