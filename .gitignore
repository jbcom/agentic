# Standard .gitignore for all projects
# Managed by agentic-dev-library/control-center

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environments
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Rust
target/
Cargo.lock

# Node.js
node_modules/
dist/
.npm
coverage/
packages/*/coverage/
coverage.xml
.coverage

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Nx
.nx/

# uv
uv.lock

# Tox
.tox/

# Sphinx output (auto-generated)
docs/src/content/docs/api/_generated/

# Astro
docs/.astro/
docs/dist/
docs/playwright-report/
docs/test-results/

# Local docs review artifacts
agentic-coach-*.png
amber-rebrand-*.png
signal-amber-*.png
output.json

# Local package preview artifacts
packages/meshy-content-generator/.tmp-preview/
packages/meshy-content-generator/.tmp-test/

# AI / Agents
memory-bank/
# .cursor/ is managed below
! .cursor/rules/
! .cursor/rules/*
! .cursor/Dockerfile
! .cursor/environment.json
! .cursor/mcp.json
