{
  "name": "agentic-docs",
  "tags": ["scope:docs"],
  "targets": {
    "build": {
      "command": "astro build",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/astro.config.mjs"]
    },
    "dev": {
      "command": "astro dev",
      "options": { "cwd": "{projectRoot}" }
    }
  }
}
